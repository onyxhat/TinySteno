HomeScreen {
    align: center top;
}

#panel {
    width: 100%;
    max-width: 72;
    height: 1fr;
    padding: 1 2 0 2;
}

.field {
    height: 3;
}

.field-label {
    width: 10;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

#name, #persona {
    width: 1fr;
}

#timeout-hint {
    height: 1;
    margin: 0 0 1 10;
    color: $text-muted;
}

#timeout-hint.error {
    color: $error;
}

#record {
    width: 100%;
    margin-bottom: 1;
    text-style: bold;
}

/* Textual's default focus style reverses the label, which drew it as a dark box on the
   green button; mark focus with an underline instead. */
#record:focus {
    text-style: bold underline;
}

#recent-label {
    color: $text-muted;
}

#recent {
    width: 100%;
    height: 1fr;
    min-height: 3;
}

/* ── Recording ─────────────────────────────────────────────────────────── */

RecordingScreen {
    align: center top;
}

#rec-panel {
    width: 100%;
    max-width: 72;
    height: auto;
    padding: 1 2;
    border: round $error;
    border-title-color: $error;
    border-title-style: bold;
    /* Only the border animates: Textual 8.2 does not repaint children while an ancestor's
       background transitions, which left them as dark boxes on the tinted panel. */
    transition: border 400ms;
}

RecordingScreen.-warning #rec-panel {
    border: heavy $warning;
    border-title-color: $warning;
    background: $warning 15%;
}

#rec-indicator {
    color: $error;
    text-style: bold;
}

#elapsed {
    width: auto;
    margin: 1 0;
}

.meter {
    height: 2;
    margin-bottom: 1;
}

.meter-label {
    width: 8;
    height: 2;
    content-align: left bottom;
    color: $text-muted;
}

#mic-level, #system-level {
    width: 1fr;
}

#system-unavailable {
    display: none;
    width: 1fr;
    color: $text-muted;
    text-style: italic;
}

#timeout-label {
    margin-top: 1;
}

RecordingScreen.-warning #timeout-label {
    color: $warning;
    text-style: bold;
}

#timeout-bar {
    width: 100%;
}

#timeout-bar Bar {
    width: 1fr;
}

/* ── Discard confirmation ──────────────────────────────────────────────── */

ConfirmDiscard {
    align: center middle;
    background: $background 60%;
}

#confirm-box {
    width: 56;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#confirm-title {
    text-style: bold;
    margin-bottom: 1;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#confirm-buttons Button {
    margin-left: 2;
}

/* ── Processing ────────────────────────────────────────────────────────── */

ProcessingScreen {
    align: center top;
}

#proc-panel {
    width: 100%;
    max-width: 72;
    height: auto;
    padding: 1 2;
    border: round $accent;
    border-title-style: bold;
}

.stage {
    height: 1;
    transition: color 300ms;
}

.stage.-pending {
    color: $text-muted;
}

.stage.-active {
    color: $accent;
    text-style: bold;
}

.stage.-done {
    color: $success;
}

.stage.-skipped {
    color: $text-muted;
    text-style: italic;
}

.stage.-failed {
    color: $error;
}

#transcribe-bar {
    width: 100%;
    padding-left: 2;
}

#transcribe-bar Bar {
    width: 1fr;
}

#error {
    display: none;
    margin-top: 1;
    color: $error;
}

/* ── Result ────────────────────────────────────────────────────────────── */

ResultScreen {
    align: center top;
}

#note-scroll {
    width: 100%;
    max-width: 88;
    height: 1fr;
    padding: 0 2;
    border: round $success;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}

#note-path {
    width: 100%;
    max-width: 88;
    padding: 0 2;
    color: $text-muted;
}

/* ── Menu ──────────────────────────────────────────────────────────────── */

MenuScreen {
    align: center middle;
    background: $background 60%;
}

#menu-box {
    width: 40;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#menu-title {
    text-style: bold;
    margin-bottom: 1;
}

#menu {
    height: auto;
    max-height: 12;
}

/* ── Confirmation (shares the box, title and buttons of the discard dialog) ── */

ConfirmScreen {
    align: center middle;
    background: $background 60%;
}

/* ── Settings ──────────────────────────────────────────────────────────── */

SettingsScreen {
    align: center top;
}

#settings-panel {
    width: 100%;
    max-width: 88;
    height: 1fr;
    padding: 0 1;
}

#settings-form {
    height: 1fr;
}

.setting {
    height: auto;
    margin-bottom: 1;
}

.setting-label {
    text-style: bold;
}

.setting-help {
    color: $text-muted;
}

#load-error {
    margin: 1 0;
    color: $error;
}

#config-path {
    color: $text-muted;
}

#form-error {
    display: none;
    height: auto;
    color: $error;
}

#settings-buttons {
    height: 1;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#settings-buttons Button {
    margin-left: 2;
}

/* ── System check ──────────────────────────────────────────────────────── */

ChecksScreen {
    align: center top;
}

#checks-panel {
    width: 100%;
    max-width: 88;
    height: 1fr;
    padding: 0 1;
}

#checks-summary {
    text-style: bold;
    margin: 1 0 0 0;
}

#checks-note {
    color: $warning;
}

#checks-list {
    height: 1fr;
    margin-top: 1;
}

.check-row {
    height: auto;
}

.check-row.ok {
    color: $success;
}

.check-row.fail {
    color: $error;
}

.check-row.warn {
    color: $warning;
}

#checks-buttons {
    height: 1;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#checks-buttons Button {
    margin-left: 2;
}

/* ── Setup guide ───────────────────────────────────────────────────────── */

SetupScreen {
    align: center top;
}

#setup-panel {
    width: 100%;
    max-width: 88;
    height: 1fr;
    padding: 0 1;
}

#setup-intro {
    margin: 1 0;
}

#setup-no-personas {
    color: $warning;
    margin-bottom: 1;
}

#setup-form {
    height: 1fr;
}

#setup-buttons {
    height: 1;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#setup-buttons Button {
    margin-left: 2;
}

/* ── Personas ──────────────────────────────────────────────────────────── */

PersonasScreen {
    align: center top;
}

#personas-panel {
    width: 100%;
    max-width: 88;
    height: 1fr;
    padding: 0 1;
}

#personas-note {
    margin: 1 0 0 0;
    color: $warning;
}

#personas {
    height: 1fr;
    margin-top: 1;
}

/* ── Recordings ────────────────────────────────────────────────────────── */

RecordingsScreen {
    align: center top;
}

#recordings-panel {
    width: 100%;
    max-width: 88;
    height: 1fr;
    padding: 0 1;
}

#recordings-note {
    color: $warning;
}

#recordings {
    height: 1fr;
}
